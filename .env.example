# Copier ce fichier en .env.local et remplir avec les clés de votre projet Supabase
# (Supabase > bouton Connect). Facultatif : les codes publics du projet sont déjà dans src/lib/supabase/config.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Étape 6 : abonnement Stripe. Clé SECRÈTE (sk_test_… puis sk_live_…) : uniquement dans Vercel, jamais ailleurs.
# Sans cette clé, tout reste gratuit (pratique pour les tests).
STRIPE_SECRET_KEY=
